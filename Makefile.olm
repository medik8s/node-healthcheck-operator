# Source-to-OLM deployment targets.
#
# This file is included by the repository Makefile. It intentionally keeps its
# variables and helper targets prefixed with OLM_ so the existing development
# targets remain unchanged.

SHELL := /usr/bin/env bash
.SHELLFLAGS := -euo pipefail -c

# Public tool-version knobs, matching the names used by the main Makefile.
# When this file is included, the main Makefile's file-local defaults remain
# untouched; command-line/environment values are honored below.
CONTROLLER_GEN_VERSION ?= v0.20.1
OPERATOR_SDK_VERSION ?= v1.42.3
KUSTOMIZE_VERSION ?= v5@v5.8.1

# Keep the conventional tool-version variable names usable from the
# environment/command line. The main Makefile has its own defaults, so its
# file-local values are deliberately not inherited by this isolated flow.
OLM_CONTROLLER_GEN_VERSION ?= v0.20.1
OLM_OPERATOR_SDK_VERSION ?= v1.42.3
OLM_KUSTOMIZE_VERSION ?= v5.8.1
ifneq ($(filter command line environment environment override,$(origin CONTROLLER_GEN_VERSION)),)
OLM_CONTROLLER_GEN_VERSION := $(CONTROLLER_GEN_VERSION)
endif
ifneq ($(filter command line environment environment override,$(origin OPERATOR_SDK_VERSION)),)
OLM_OPERATOR_SDK_VERSION := $(OPERATOR_SDK_VERSION)
endif
ifneq ($(filter command line environment environment override,$(origin KUSTOMIZE_VERSION)),)
OLM_KUSTOMIZE_VERSION := $(KUSTOMIZE_VERSION)
ifneq (,$(filter v5@v%,$(KUSTOMIZE_VERSION)))
OLM_KUSTOMIZE_VERSION := $(patsubst v5@v%,v%,$(KUSTOMIZE_VERSION))
endif
endif

OLM_OPERATOR_NAME ?= node-healthcheck-operator
OLM_PACKAGE_NAME ?= $(OLM_OPERATOR_NAME)
OLM_OPERATOR_NAMESPACE ?= openshift-workload-availability
OLM_CHANNEL ?= stable
OLM_VERSION ?= 0.0.1
OLM_DEFAULT_VERSION_DISPLAY := $(if $(DEFAULT_VERSION),$(DEFAULT_VERSION),$(OLM_VERSION))
OLM_PROJECT_VERSION_DISPLAY := $(if $(VERSION),$(VERSION),$(OLM_VERSION))
OLM_GO_TOOLCHAIN_VERSION := $(shell awk '$$1 == "toolchain" {print $$2}' go.mod 2>/dev/null)
OLM_CATALOG_SOURCE_NAME ?= $(OLM_PACKAGE_NAME)-catalog
OLM_CATALOG_SOURCE_NAMESPACE ?= $(OLM_OPERATOR_NAMESPACE)
OLM_OPERATOR_GROUP_NAME ?= operator-sdk-og
OLM_INSTALL_MODE ?= AllNamespaces
OLM_SECURITY_CONTEXT_CONFIG ?= restricted

TTL_DURATION ?= 1h
OLM_TTL_DURATION ?= $(TTL_DURATION)
OLM_GIT_REV ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo local)
OLM_IMAGE_PREFIX ?= ttl.sh/$(OLM_OPERATOR_NAME)-$(OLM_GIT_REV)
OLM_OPERATOR_IMAGE ?= $(OLM_IMAGE_PREFIX):$(OLM_TTL_DURATION)
OLM_BUNDLE_IMAGE ?= $(OLM_IMAGE_PREFIX)-bundle:$(OLM_TTL_DURATION)

OLM_PLATFORM ?= linux/amd64
OLM_CONTAINER_TOOL ?= $(if $(shell command -v podman 2>/dev/null),podman,$(if $(shell command -v docker 2>/dev/null),docker,))
OLM_OC ?= $(if $(shell command -v oc 2>/dev/null),oc,kubectl)
OLM_GOOS ?= $(shell go env GOOS 2>/dev/null || echo linux)
OLM_GOARCH ?= $(shell go env GOARCH 2>/dev/null || echo amd64)

OLM_LOCALBIN ?= $(if $(LOCALBIN),$(LOCALBIN),$(CURDIR)/bin)/olm
OLM_OPERATOR_SDK ?= $(OLM_LOCALBIN)/operator-sdk-$(OLM_OPERATOR_SDK_VERSION)
OLM_CONTROLLER_GEN ?= $(OLM_LOCALBIN)/controller-gen-$(OLM_CONTROLLER_GEN_VERSION)
OLM_KUSTOMIZE ?= $(OLM_LOCALBIN)/kustomize-$(OLM_KUSTOMIZE_VERSION)

$(info Using Container Tool: $(OLM_CONTAINER_TOOL))

define OLM_CHECK_TOOL_VERSION
	@printf "\n\033[1m$(1) Version Check:\033[0m\n"
	@if [ -x "$(2)" ]; then \
		installed_version="$$($(3) || echo unknown)"; \
		expected_version="$(4)"; \
		if [ "$$installed_version" = "$$expected_version" ]; then \
			printf "\033[32m%-30s\033[0m %-20s %s\n" "$(5)" "$$installed_version" "✓ matches Makefile"; \
		else \
			printf "\033[33m%-30s\033[0m %-20s %s\n" "$(5)" "$$installed_version" "⚠ differs from Makefile ($$expected_version)"; \
		fi; \
	else \
		printf "\033[31m%-30s\033[0m %-20s %s\n" "$(5)" "not found" "✗ not installed in $(OLM_LOCALBIN)"; \
	fi
endef

.PHONY: check-go
check-go: ## Check if go binary is available in PATH.
	@if ! command -v go >/dev/null 2>&1; then \
		printf '\033[31m✗ Error: go binary not found in PATH\033[0m\n'; \
		printf 'Go is required to install the pinned source-deployment tools.\n'; \
		exit 1; \
	fi
	@printf '\033[32m✓ Go binary found in PATH\033[0m\n'

.PHONY: versions
versions: check-go olm-tools ## Display source-deployment tool and project versions.
	@printf '\033[36m%-30s\033[0m %s\n' 'GO_VERSION' "$$(go version | awk '{print $$3}')"
	@printf '\n\033[1m%-30s %-20s %s\033[0m\n' 'Tool and Project Versions:' 'Value' 'Used by Targets'
	@printf '\033[36m%-30s\033[0m %-20s %s\n' 'DEFAULT_VERSION' '$(OLM_DEFAULT_VERSION_DISPLAY)' 'bundle'
	@printf '\033[36m%-30s\033[0m %-20s %s\n' 'VERSION' '$(OLM_PROJECT_VERSION_DISPLAY)' 'bundle, deploy-olm'
	@printf '\033[36m%-30s\033[0m %-20s %s\n' 'OPERATOR_SDK_VERSION' '$(OLM_OPERATOR_SDK_VERSION)' 'operator-sdk, bundle'
	@printf '\033[36m%-30s\033[0m %-20s %s\n' 'ENVTEST_K8S_VERSION' 'not used' 'not used by source deployment'
	@printf '\033[36m%-30s\033[0m %-20s %s\n' 'GOLANGCI_LINT_VERSION' 'not used' 'not used by source deployment'
	@printf '\033[36m%-30s\033[0m %-20s %s\n' 'KUSTOMIZE_VERSION' '$(OLM_KUSTOMIZE_VERSION)' 'kustomize, bundle'
	@printf '\033[36m%-30s\033[0m %-20s %s\n' 'CONTROLLER_TOOLS_VERSION' '$(OLM_CONTROLLER_GEN_VERSION)' 'controller-gen, bundle'
	@printf '\033[36m%-30s\033[0m %-20s %s\n' 'OLM_VERSION' '$(OLM_VERSION)' 'bundle, deploy-olm'
	@printf '\033[36m%-30s\033[0m %-20s %s\n' 'OLM_CHANNEL' '$(OLM_CHANNEL)' 'bundle, deploy-olm'
	@printf '\033[36m%-30s\033[0m %-20s %s\n' 'GO_TOOLCHAIN_VERSION' '$(OLM_GO_TOOLCHAIN_VERSION)' '(informational only)'
	$(call OLM_CHECK_TOOL_VERSION,Operator-SDK,$(OLM_OPERATOR_SDK),$(OLM_OPERATOR_SDK) version 2>/dev/null | awk -F'"' '/operator-sdk version/ {print $$2}',$(OLM_OPERATOR_SDK_VERSION),OPERATOR_SDK_LOCAL)
	$(call OLM_CHECK_TOOL_VERSION,Controller-Gen,$(OLM_CONTROLLER_GEN),$(OLM_CONTROLLER_GEN) --version 2>/dev/null | awk '/Version:/ {print $$2}',$(OLM_CONTROLLER_GEN_VERSION),CONTROLLER_GEN_LOCAL)
	$(call OLM_CHECK_TOOL_VERSION,Kustomize,$(OLM_KUSTOMIZE),$(OLM_KUSTOMIZE) version 2>/dev/null | sed -nE 's/.*(v[0-9]+\.[0-9]+\.[0-9]+).*/\1/p',$(OLM_KUSTOMIZE_VERSION),KUSTOMIZE_LOCAL)

.PHONY: olm-controller-gen
olm-controller-gen:
	@if [ ! -x "$(OLM_CONTROLLER_GEN)" ]; then \
		command -v go >/dev/null 2>&1 || { echo "go is required to download controller-gen" >&2; exit 1; }; \
		mkdir -p "$(dir $(OLM_CONTROLLER_GEN))"; \
		tmp_dir="$$(mktemp -d)"; \
		trap 'rm -rf "$$tmp_dir"' EXIT; \
		cd "$$tmp_dir"; \
		go mod init olm-tools >/dev/null; \
		GOBIN="$(abspath $(dir $(OLM_CONTROLLER_GEN)))" GOFLAGS='' go install sigs.k8s.io/controller-tools/cmd/controller-gen@$(OLM_CONTROLLER_GEN_VERSION); \
		mv "$(abspath $(dir $(OLM_CONTROLLER_GEN)))/controller-gen" "$(abspath $(OLM_CONTROLLER_GEN))"; \
	fi

.PHONY: olm-operator-sdk
olm-operator-sdk:
	@command -v curl >/dev/null 2>&1 || { echo "curl is required to download operator-sdk" >&2; exit 1; }
	@mkdir -p "$(dir $(OLM_OPERATOR_SDK))"
	@if [ ! -x "$(OLM_OPERATOR_SDK)" ]; then \
		url="https://github.com/operator-framework/operator-sdk/releases/download/$(OLM_OPERATOR_SDK_VERSION)/operator-sdk_$(OLM_GOOS)_$(OLM_GOARCH)"; \
		echo "Downloading $$url"; \
		curl --fail --retry 5 --retry-delay 5 -sSLo "$(OLM_OPERATOR_SDK).tmp" "$$url"; \
		chmod +x "$(OLM_OPERATOR_SDK).tmp"; \
		mv "$(OLM_OPERATOR_SDK).tmp" "$(OLM_OPERATOR_SDK)"; \
	fi

.PHONY: olm-kustomize
olm-kustomize:
	@if [ ! -x "$(OLM_KUSTOMIZE)" ]; then \
		command -v go >/dev/null 2>&1 || { echo "go is required to download kustomize" >&2; exit 1; }; \
		mkdir -p "$(dir $(OLM_KUSTOMIZE))"; \
		tmp_dir="$$(mktemp -d)"; \
		trap 'rm -rf "$$tmp_dir"' EXIT; \
		cd "$$tmp_dir"; \
		go mod init olm-tools >/dev/null; \
		GOBIN="$(abspath $(dir $(OLM_KUSTOMIZE)))" GOFLAGS='' go install sigs.k8s.io/kustomize/kustomize/v5@$(OLM_KUSTOMIZE_VERSION); \
		if [ "$(abspath $(OLM_KUSTOMIZE))" != "$(abspath $(dir $(OLM_KUSTOMIZE)))/kustomize" ]; then \
			mv "$(abspath $(dir $(OLM_KUSTOMIZE)))/kustomize" "$(abspath $(OLM_KUSTOMIZE))"; \
		fi; \
	fi

.PHONY: olm-tools
olm-tools: olm-controller-gen olm-operator-sdk olm-kustomize ## Download pinned source-deployment tools into bin/olm.

.PHONY: olm-build-push
olm-build-push: olm-tools ## Build and push source and OLM bundle images to ttl.sh.
	@command -v "$(OLM_CONTAINER_TOOL)" >/dev/null 2>&1 || { echo "Container tool '$(OLM_CONTAINER_TOOL)' is not available" >&2; exit 1; }
	@echo "Building $(OLM_OPERATOR_IMAGE) with the Konveyor builder"
	$(OLM_CONTAINER_TOOL) build --platform=$(OLM_PLATFORM) \
		-f Dockerfile -t $(OLM_OPERATOR_IMAGE) .
	@echo "Generating OLM bundle with operator-sdk $(OLM_OPERATOR_SDK_VERSION)"
	GOFLAGS=-mod=mod $(OLM_CONTROLLER_GEN) rbac:roleName=manager-role crd webhook paths="./..." output:crd:artifacts:config=config/crd/bases
	$(OLM_OPERATOR_SDK) generate --verbose kustomize manifests --input-dir ./config/manifests/base --output-dir ./config/manifests/base
	cd config/manifests/base && $(OLM_KUSTOMIZE) edit set image controller=$(OLM_OPERATOR_IMAGE)
	$(OLM_KUSTOMIZE) build config/manifests/base | $(OLM_OPERATOR_SDK) generate bundle -q --manifests --metadata --overwrite \
		--version $(OLM_VERSION) --channels=$(OLM_CHANNEL) --default-channel=$(OLM_CHANNEL)
	@csv=""; \
	for candidate in bundle/manifests/*.clusterserviceversion.yaml; do \
		[ -f "$$candidate" ] && { csv="$$candidate"; break; }; \
	done; \
	test -n "$$csv" || { echo "No ClusterServiceVersion was generated" >&2; exit 1; }; \
	sed -i.bak 's|^    containerImage: .*|    containerImage: $(OLM_OPERATOR_IMAGE)|' "$$csv"; \
	rm "$$csv.bak"; \
	"$(OLM_OPERATOR_SDK)" bundle validate ./bundle --select-optional suite=operatorframework
	@echo "Building $(OLM_BUNDLE_IMAGE)"
	$(OLM_CONTAINER_TOOL) build --platform=$(OLM_PLATFORM) -f bundle.Dockerfile -t $(OLM_BUNDLE_IMAGE) .
	@echo "Pushing source images to ttl.sh"
	$(OLM_CONTAINER_TOOL) push $(OLM_OPERATOR_IMAGE)
	$(OLM_CONTAINER_TOOL) push $(OLM_BUNDLE_IMAGE)

.PHONY: deploy-olm
deploy-olm: versions ## Display versions, then build source, push temporary images to ttl.sh, and install the operator with operator-sdk.
	@set -euo pipefail; \
	command -v "$(OLM_OC)" >/dev/null 2>&1 || { echo "OpenShift/Kubernetes CLI '$(OLM_OC)' is required" >&2; exit 1; }; \
	if ! identity="$$($(OLM_OC) whoami 2>&1)"; then \
		server="$$($(OLM_OC) whoami --show-server 2>/dev/null || true)"; \
		echo "Unable to reach or authenticate to OpenShift$${server:+ at $$server}." >&2; \
		echo "$$identity" >&2; \
		exit 1; \
	fi; \
	work_dir="$$(mktemp -d)"; \
	cleanup_work_dir() { chmod -R 777 "$$work_dir" 2>/dev/null || true; rm -rf "$$work_dir"; }; \
	trap cleanup_work_dir EXIT; \
	cp -r . "$$work_dir/source"; \
	chmod -R 777 "$$work_dir/source"; \
	rm -rf "$$work_dir/source/bin"; \
	cd "$$work_dir/source"; \
	$(MAKE) -f Makefile.olm olm-build-push \
		OLM_CONTROLLER_GEN_VERSION='$(OLM_CONTROLLER_GEN_VERSION)' \
		OLM_OPERATOR_SDK_VERSION='$(OLM_OPERATOR_SDK_VERSION)' \
		OLM_KUSTOMIZE_VERSION='$(OLM_KUSTOMIZE_VERSION)' \
		OLM_OPERATOR_NAME='$(OLM_OPERATOR_NAME)' \
		OLM_PACKAGE_NAME='$(OLM_PACKAGE_NAME)' \
		OLM_OPERATOR_NAMESPACE='$(OLM_OPERATOR_NAMESPACE)' \
		OLM_CHANNEL='$(OLM_CHANNEL)' \
		OLM_VERSION='$(OLM_VERSION)' \
		OLM_INSTALL_MODE='$(OLM_INSTALL_MODE)' \
		OLM_SECURITY_CONTEXT_CONFIG='$(OLM_SECURITY_CONTEXT_CONFIG)' \
		OLM_TTL_DURATION='$(OLM_TTL_DURATION)' \
		OLM_GIT_REV='$(OLM_GIT_REV)' \
		OLM_IMAGE_PREFIX='$(OLM_IMAGE_PREFIX)' \
		OLM_OPERATOR_IMAGE='$(OLM_OPERATOR_IMAGE)' \
		OLM_BUNDLE_IMAGE='$(OLM_BUNDLE_IMAGE)' \
		OLM_PLATFORM='$(OLM_PLATFORM)' \
		OLM_CONTAINER_TOOL='$(OLM_CONTAINER_TOOL)' \
		OLM_OC='$(OLM_OC)' \
		OLM_LOCALBIN='$(OLM_LOCALBIN)' \
		OLM_CONTROLLER_GEN='$(OLM_CONTROLLER_GEN)' \
		OLM_OPERATOR_SDK='$(OLM_OPERATOR_SDK)' \
		OLM_KUSTOMIZE='$(OLM_KUSTOMIZE)'; \
	"$(OLM_OC)" get namespace "$(OLM_OPERATOR_NAMESPACE)" >/dev/null 2>&1 || \
		"$(OLM_OC)" create namespace "$(OLM_OPERATOR_NAMESPACE)"; \
	"$(OLM_OPERATOR_SDK)" -n "$(OLM_OPERATOR_NAMESPACE)" cleanup "$(OLM_PACKAGE_NAME)" --delete-all >/dev/null 2>&1 || true; \
	echo "Installing $(OLM_BUNDLE_IMAGE) into $(OLM_OPERATOR_NAMESPACE)"; \
	"$(OLM_OPERATOR_SDK)" -n "$(OLM_OPERATOR_NAMESPACE)" run bundle "$(OLM_BUNDLE_IMAGE)" \
		--install-mode="$(OLM_INSTALL_MODE)" \
		--security-context-config="$(OLM_SECURITY_CONTEXT_CONFIG)"; \
	"$(OLM_OC)" get csv -n "$(OLM_OPERATOR_NAMESPACE)"

.PHONY: undeploy-olm
undeploy-olm: olm-operator-sdk ## Remove the source operator installed by deploy-olm.
	@set -euo pipefail; \
	command -v "$(OLM_OC)" >/dev/null 2>&1 || { echo "OpenShift/Kubernetes CLI '$(OLM_OC)' is required" >&2; exit 1; }; \
	if ! identity="$$($(OLM_OC) whoami 2>&1)"; then \
		server="$$($(OLM_OC) whoami --show-server 2>/dev/null || true)"; \
		echo "Unable to reach or authenticate to OpenShift$${server:+ at $$server}." >&2; \
		echo "$$identity" >&2; \
		exit 1; \
	fi; \
	"$(OLM_OC)" get namespace "$(OLM_OPERATOR_NAMESPACE)" >/dev/null 2>&1 || \
		"$(OLM_OC)" create namespace "$(OLM_OPERATOR_NAMESPACE)"; \
	"$(OLM_OPERATOR_SDK)" -n "$(OLM_OPERATOR_NAMESPACE)" cleanup "$(OLM_PACKAGE_NAME)" --delete-all >/dev/null 2>&1 || true; \
	subscriptions="$$($(OLM_OC) get subscription -n "$(OLM_OPERATOR_NAMESPACE)" -o jsonpath='{range .items[?(@.spec.source=="$(OLM_CATALOG_SOURCE_NAME)")]}{.metadata.name}{"\n"}{end}' 2>/dev/null || true)"; \
	while IFS= read -r subscription; do \
		[ -z "$$subscription" ] || "$(OLM_OC)" delete subscription "$$subscription" -n "$(OLM_OPERATOR_NAMESPACE)" --ignore-not-found=true; \
	done <<< "$$subscriptions"; \
	"$(OLM_OC)" delete subscription "$(OLM_PACKAGE_NAME)" -n "$(OLM_OPERATOR_NAMESPACE)" --ignore-not-found=true; \
	"$(OLM_OC)" delete csv -l "operators.coreos.com/$(OLM_PACKAGE_NAME).$(OLM_OPERATOR_NAMESPACE)" -n "$(OLM_OPERATOR_NAMESPACE)" --ignore-not-found=true; \
	csvs="$$($(OLM_OC) get csv -n "$(OLM_OPERATOR_NAMESPACE)" -o name 2>/dev/null | grep -E "/$(OLM_PACKAGE_NAME)(\.|$$)" || true)"; \
	while IFS= read -r csv; do \
		[ -z "$$csv" ] || "$(OLM_OC)" delete "$$csv" -n "$(OLM_OPERATOR_NAMESPACE)" --ignore-not-found=true; \
	done <<< "$$csvs"; \
	"$(OLM_OC)" delete catalogsource "$(OLM_CATALOG_SOURCE_NAME)" -n "$(OLM_CATALOG_SOURCE_NAMESPACE)" --ignore-not-found=true; \
	"$(OLM_OC)" delete operatorgroup "$(OLM_OPERATOR_GROUP_NAME)" -n "$(OLM_OPERATOR_NAMESPACE)" --ignore-not-found=true

.PHONY: olm-help
olm-help: ## Display source-to-OLM deployment variables.
	@printf '%s\n' \
		"CONTROLLER_GEN_VERSION=$(OLM_CONTROLLER_GEN_VERSION)" \
		"OPERATOR_SDK_VERSION=$(OLM_OPERATOR_SDK_VERSION)" \
		"KUSTOMIZE_VERSION=$(OLM_KUSTOMIZE_VERSION)" \
		"OLM_LOCALBIN=$(OLM_LOCALBIN)" \
		"OLM_INSTALL_MODE=$(OLM_INSTALL_MODE)" \
		"OLM_SECURITY_CONTEXT_CONFIG=$(OLM_SECURITY_CONTEXT_CONFIG)" \
		"OLM_CATALOG_SOURCE_NAME=$(OLM_CATALOG_SOURCE_NAME)" \
		"OLM_CATALOG_SOURCE_NAMESPACE=$(OLM_CATALOG_SOURCE_NAMESPACE)" \
		"OLM_OPERATOR_GROUP_NAME=$(OLM_OPERATOR_GROUP_NAME)" \
		"OLM_OPERATOR_IMAGE=$(OLM_OPERATOR_IMAGE)" \
		"OLM_BUNDLE_IMAGE=$(OLM_BUNDLE_IMAGE)" \
		"OLM_TTL_DURATION=$(OLM_TTL_DURATION)"

